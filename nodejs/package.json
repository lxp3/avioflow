{
  "name": "avioflow",
  "version": "0.3.2",
  "description": "High-performance audio decoding and device discovery library using FFmpeg",
  "author": "lxp3",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src/index.js",
    "src/index.cjs",
    "src/index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxp3/avioflow.git"
  },
  "bugs": {
    "url": "https://github.com/lxp3/avioflow/issues"
  },
  "homepage": "https://github.com/lxp3/avioflow#readme",
  "keywords": [
    "audio",
    "ffmpeg",
    "realtime",
    "native",
    "napi",
    "electron",
    "vscode"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "node tests/test-offline-load.js",
    "build": "cmake-js compile",
    "prebuild": "prebuildify --napi --strip --tag-libc"
  },
  "optionalDependencies": {
    "@lxp3/darwin-arm64": "0.3.2",
    "@lxp3/darwin-x64": "0.3.2",
    "@lxp3/linux-arm64": "0.3.2",
    "@lxp3/linux-x64": "0.3.2",
    "@lxp3/win32-arm64": "0.3.2",
    "@lxp3/win32-x64": "0.3.2"
  },
  "devDependencies": {
    "cmake-js": "^7.3.0",
    "electron": "34.0.0",
    "node-addon-api": "^8.0.0",
    "prebuildify": "^6.0.0"
  }
}
