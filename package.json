{
  "name": "avioflow",
  "version": "0.1.10",
  "description": "High-performance audio decoding and device discovery library using FFmpeg",
  "author": "lxp3",
  "license": "MIT",
  "type": "module",
  "main": "avioflow/nodejs/index.js",
  "types": "avioflow/nodejs/index.d.ts",
  "exports": {
    ".": {
      "types": "./avioflow/nodejs/index.d.ts",
      "import": "./avioflow/nodejs/index.js",
      "require": "./avioflow/nodejs/index.js"
    }
  },
  "files": [
    "avioflow/nodejs/",
    "avioflow/include/",
    "prebuilds/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxp3/avioflow.git"
  },
  "bugs": {
    "url": "https://github.com/lxp3/avioflow/issues"
  },
  "homepage": "https://github.com/lxp3/avioflow#readme",
  "keywords": [
    "audio",
    "ffmpeg",
    "realtime",
    "native",
    "napi",
    "electron",
    "vscode"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "node tests/nodejs/test-local.js",
    "build": "cmake-js compile",
    "prebuild": "prebuildify --napi --strip --tag-libc",
    "prebuild-electron": "prebuildify --napi --strip --tag-libc --platform=win32 --arch=x64 -r electron -t 28.0.0 -t 30.0.0 -t 32.0.0 -t 34.0.0",
    "install": "node-gyp-build || echo 'Prebuild not found, native module may need to be built manually'"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.6.0"
  },
  "devDependencies": {
    "cmake-js": "^7.3.0",
    "prebuildify": "^6.0.0"
  }
}