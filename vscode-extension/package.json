{
    "name": "avioflow",
    "displayName": "Avioflow",
    "description": "High-performance audio engine and toolkit for VS Code",
    "version": "0.2.1",
    "publisher": "lxp3",
    "repository": {
        "type": "git",
        "url": "https://github.com/lxp3/avioflow"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/src/extension.js",
    "activationEvents": [
        "onCustomEditor:avioflow.audioPreview",
        "onView:avioflow.homeView"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "avioflow-explorer",
                    "title": "Avioflow",
                    "icon": "$(music)"
                }
            ]
        },
        "views": {
            "avioflow-explorer": [
                {
                    "type": "webview",
                    "id": "avioflow.homeView",
                    "name": "Avioflow Home"
                }
            ]
        },
        "customEditors": [
            {
                "viewType": "avioflow.audioPreview",
                "displayName": "Avioflow Audio Preview",
                "selector": [
                    {
                        "filenamePattern": "*.{mp3,wav,flac,m4a,ogg,aac}"
                    }
                ],
                "priority": "default"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm run compile",
        "compile": "pnpm run build:webview && tsc -p ./",
        "watch": "tsc -watch -p ./",
        "build:webview": "vite build webview"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^3.0.0",
        "@tsconfig/svelte": "^5.0.0",
        "@types/node": "~20.19.30",
        "@types/vscode": "^1.75.0",
        "@vscode/vsce": "^3.0.0",
        "@typescript-eslint/eslint-plugin": "^5.59.1",
        "@typescript-eslint/parser": "^5.59.1",
        "autoprefixer": "^10.4.24",
        "eslint": "^8.39.0",
        "postcss": "^8.5.6",
        "svelte": "^4.0.0",
        "svelte-check": "^3.6.0",
        "svelte-preprocess": "^5.1.0",
        "tailwindcss": "^3.4.19",
        "tslib": "^2.6.0",
        "typescript": "^5.0.0",
        "vite": "^5.0.0"
    }
}